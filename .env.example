# Required in production (Netlify → Site settings → Environment variables).
# Not needed for local dev: `npm run dev` falls back to a JSON file store + dev secret.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ajaia-docs?retryWrites=true&w=majority
SESSION_SECRET=<long-random-string>   # e.g. `openssl rand -hex 32`

# Optional: force the local JSON file store even if MONGODB_URI is set (local dev only).
# LOCAL_STORE=1
